programa {
  funcao inicio() {
    //PARA (FOR) PARA TABUADA A PARTIR DE UM NUMERO

    inteiro i
    inteiro numero
    inteiro resultado

    escreva("Digite um número para multiplicação: ")
    leia (numero)

    escreva ("Tabuada: ", numero, "\n")

    para (i = 1; i <= 10; i++)
    {
      escreva (numero, "x", i, "=", numero * i, "\n")
    }
  }
}
